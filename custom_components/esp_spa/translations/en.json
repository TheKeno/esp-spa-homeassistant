        "data_description": {
          "host": "Usually spa.local, or the module's IP address."
        }
      },
      "password": {
        "title": "Settings password",
        "description": "Enter the module's settings password (the one chosen when the module was set up). It is used once to get a token for Home Assistant and is not stored. Getting a new token replaces any earlier one.",
