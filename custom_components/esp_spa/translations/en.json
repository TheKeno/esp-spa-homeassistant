          "password": "Settings password"
        }
      },
      "reauth_confirm": {
        "title": "Settings password",
        "description": "The spa module at {host} no longer accepts Home Assistant's token (for example after a factory reset or after another Home Assistant was set up with it). Enter the settings password to get a new one.",
        "data": {
          "password": "Settings password"
        }
      }
    },
    "error": {
